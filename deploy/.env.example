# Copy to .env and fill in. The backend reads every MESHUB_* variable as a
# setting: see server/meshub.example.yaml.

# Image tag to run; "latest" for the newest release.
MESHUB_VERSION=latest

# The backend's broker user (mosquitto_passwd ./mosquitto/passwd meshub).
MESHUB_MQTT_PASSWORD=

# API tokens, comma separated, at least 16 characters: openssl rand -hex 32
MESHUB_API_TOKENS=

# Web UI login (user admin).
MESHUB_UI_PASSWORD=

# The name the hub advertises on the mesh.
MESHUB_HUB_NAME=meshub
